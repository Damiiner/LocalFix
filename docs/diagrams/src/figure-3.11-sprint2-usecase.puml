@startuml
title LocalFix - Sprint 2
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Admin" as A
actor "Help Requester" as HR
actor "Helper" as H

' Requested heritage between Helper and Help Requester
H --|> HR

rectangle "LocalFix - Sprint 2" {
  usecase "Authenticate" as UC_AUTH
  usecase "View Profile" as UC_VIEW_PROFILE
  usecase "Edit Profile" as UC_EDIT_PROFILE
  usecase "Send Message" as UC_SEND
  usecase "Receive Message" as UC_RECEIVE
  usecase "Report Helper" as UC_REPORT_HELPER
  usecase "Review Report" as UC_REVIEW_REPORT
}

HR --> UC_VIEW_PROFILE
HR --> UC_EDIT_PROFILE
HR --> UC_SEND
HR --> UC_RECEIVE
HR --> UC_REPORT_HELPER

H --> UC_VIEW_PROFILE
H --> UC_EDIT_PROFILE
H --> UC_SEND
H --> UC_RECEIVE

A --> UC_REVIEW_REPORT

UC_VIEW_PROFILE ..> UC_AUTH : <<include>>
UC_EDIT_PROFILE ..> UC_AUTH : <<include>>
UC_SEND ..> UC_AUTH : <<include>>
UC_RECEIVE ..> UC_AUTH : <<include>>
UC_REPORT_HELPER ..> UC_AUTH : <<include>>
UC_REVIEW_REPORT ..> UC_AUTH : <<include>>

UC_EDIT_PROFILE ..> UC_VIEW_PROFILE : <<extend>>
UC_REPORT_HELPER ..> UC_VIEW_PROFILE : <<extend>>
@enduml

