@startuml
title Sprint 2 Class Diagram
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle

class User {
  +id: int
  +name: string
  +email: string
  +status: string
  +createdAt: Date
  +updatedAt: Date
  --
  +login(email: string, password: string): boolean
  +logout(): void
}

class Profile {
  +displayName: string
  +bio: string
  +avatarUrl: string
  --
  +updateProfile(): void
  +getStats(): string
}

class Report {
  +id: int
  +title: string
  +description: string
  +createdAt: Date
  --
  +submit(): void
}

class Chat {
  +id: int
  +createdAt: Date
  --
  +addParticipant(user: User): void
}

class Message {
  +id: long
  +content: string
  +timestamp: Date
  +isRead: boolean
  --
  +send(): void
  +markRead(): void
}

' Associations (no diamonds/circles as requested)
User "1" -- "1" Profile : owns
User "1" -- "0..*" Report : submits
Chat "1" -- "0..*" Message : contains
User "0..*" -- "0..*" Chat : participates
User "1" -- "0..*" Message : sends
@enduml

