@startuml
title Sprint 1 Class Diagram
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle

class User {
  +id: int
  +name: string
  +email: string
  +status: string
  +createdAt: Date
  +updatedAt: Date
  --
  +login(email: string, password: string): boolean
  +logout(): void
  +getTasks(): Task[*]
  +createTask(data): Task
  +deleteTask(taskId: int): boolean
  +editTask(taskId: int, newData): boolean
}

class Task {
  +id: int
  +requesterId: int
  +helperId: int?
  +title: string
  +description: string
  +price: float
  +location: string
  +status: string
  +createdAt: Date
  +updatedAt: Date
  --
  +updateStatus(newStatus: string): void
  +editTask(newData): void
  +deleteTask(): boolean
}

class Category {
  +id: int
  +title: string
  +description: string
  --
  +getTasks(): Task[*]
  +addTask(task: Task): boolean
}

class Tag {
  +id: int
  +name: string
  +createdAt: Date
  +updatedAt: Date
  --
  +addToTask(task: Task): boolean
  +removeFromTask(task: Task): boolean
  +getTasks(): Task[*]
}

class Authentication {
  +id: int
  +email: string
  +passwordHash: string
  +createdAt: Date
  --
  +authenticate(email: string, password: string): boolean
  +hashPassword(password: string): string
}

' Associations (no diamonds/circles as requested)
User "1" -- "0..*" Task : creates
Task "1" -- "1" User : requester
Task "0..1" -- "1" User : helper
Category "1" -- "0..*" Task : categorizes
Task "0..*" -- "0..*" Tag : tagged
User ..> Authentication : uses
@enduml

